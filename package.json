{
  "name": "tubify",
  "productName": "Tubify",
  "version": "2.0.0",
  "description": "Unofficial desktop client for YouTube and YouTube Music with optional ad blocking, SponsorBlock and a local music library",
  "main": "src/main/main.js",
  "author": "Tubify contributors",
  "license": "MIT",
  "homepage": "https://github.com/1ZoZ1/tubify",
  "repository": {
    "type": "git",
    "url": "https://github.com/1ZoZ1/tubify.git"
  },
  "bugs": {
    "url": "https://github.com/1ZoZ1/tubify/issues"
  },
  "keywords": [
    "youtube",
    "youtube-music",
    "adblock",
    "sponsorblock",
    "yt-dlp",
    "electron",
    "desktop",
    "windows",
    "music-player",
    "downloader"
  ],
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tubify.desktop",
    "productName": "Tubify",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!build/icon-src/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tubify",
      "artifactName": "Tubify-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "copyright": "Copyright © 2026 Tubify contributors",
    "portable": {
      "artifactName": "Tubify-Portable-${version}.exe"
    }
  }
}
